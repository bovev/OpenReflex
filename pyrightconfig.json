{
  "include": [
    "backend/src",
    "backend/tests",
    "scripts",
    "packaging"
  ],
  "exclude": [
    "scripts/laya_compat/probe.py",
    "**/node_modules",
    "**/.venv"
  ],
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.12",
  "typeCheckingMode": "strict",
  "reportMissingModuleSource": false,
  "executionEnvironments": [
    {
      "root": "backend/tests",
      "extraPaths": [
        "backend/src"
      ],
      "reportPrivateUsage": false
    }
  ],
  "extraPaths": [
    "backend/src"
  ]
}
